<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_habits_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/widget_habits_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Today’s habits"
            android:textColor="@color/widget_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_habits_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_habits_empty"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <ListView
            android:id="@+id/widget_habits_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="2dp"
            android:scrollbars="vertical" />
    </LinearLayout>

    <!-- Only this control opens the app; row checkboxes toggle in-widget. -->
    <TextView
        android:id="@+id/widget_habits_add"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="bottom|end"
        android:background="@drawable/widget_card_bg"
        android:contentDescription="@string/widget_habits_add"
        android:gravity="center"
        android:text="+"
        android:textColor="@color/widget_accent"
        android:textSize="22sp"
        android:textStyle="bold" />
</FrameLayout>
