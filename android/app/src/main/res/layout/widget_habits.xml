<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_habits_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_habits_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Today’s habits"
        android:textColor="@color/widget_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_habits_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_habits_empty"
        android:textColor="@color/widget_muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout android:id="@+id/habit_row_1" android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/habit_check_1" android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@string/widget_habits_name" android:src="@drawable/widget_box_off" />
        <TextView android:id="@+id/habit_title_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_text" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/habit_streak_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_accent" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/habit_row_2" android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/habit_check_2" android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@string/widget_habits_name" android:src="@drawable/widget_box_off" />
        <TextView android:id="@+id/habit_title_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_text" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/habit_streak_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_accent" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/habit_row_3" android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/habit_check_3" android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@string/widget_habits_name" android:src="@drawable/widget_box_off" />
        <TextView android:id="@+id/habit_title_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_text" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/habit_streak_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_accent" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/habit_row_4" android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/habit_check_4" android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@string/widget_habits_name" android:src="@drawable/widget_box_off" />
        <TextView android:id="@+id/habit_title_4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_text" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/habit_streak_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_accent" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/habit_row_5" android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/habit_check_5" android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@string/widget_habits_name" android:src="@drawable/widget_box_off" />
        <TextView android:id="@+id/habit_title_5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_text" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/habit_streak_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_accent" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
